{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocx.local/contracts/block.outputStart.schema.json",
  "title": "BlockOutputStart",
  "description": "Params of the session-scoped block.outputStart notification. The row is the anchor's screen row, not the ordered output rows stream coordinate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entryId", "row", "screenRevision", "bufferKind", "bufferInstance", "cols", "rows"],
  "properties": {
    "entryId": { "type": "string", "minLength": 1 },
    "row": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "screenRevision": { "type": "integer", "minimum": 0 },
    "bufferKind": { "enum": ["normal", "alternate"] },
    "bufferInstance": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "cols": { "type": "integer", "minimum": 1 },
    "rows": { "type": "integer", "minimum": 1 }
  }
}
