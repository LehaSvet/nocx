{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },
    "repowise": {
      "command": "repowise",
      "args": ["mcp", "--transport", "stdio"],
      "description": "repowise: codebase intelligence \u2014 docs, graph, git signals, dead code, decisions",
      "env": {
        "REPOWISE_EMBEDDING_DIMS": "3072"
      }
    }
  }
}
